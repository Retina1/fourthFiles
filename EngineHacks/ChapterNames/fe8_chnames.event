//include this under free space

#include eastdlib.event
#include "Extensions/Hack Installation.txt"
PUSH
ORG $89624
jumpToHack(Chname)
POP

Chname:
#incbin "fe8_chapter_names.dmp"
ALIGN 4
POIN ChFont
POIN ChTable
POIN SpecialChapter

ALIGN 4
ChFont:
//#incext Png2Dmp "font.png" --lz77
#incbin "font.png.dmp"	//HINT=BIN

ALIGN 4
ChTable:
#incbin "chartable.dmp"	//HINT=BIN

ALIGN 4
//Final and Prologue.
SpecialChapter:
SHORT Stratum1F1 Name_St1
SHORT Stratum1F2 Name_St1
SHORT Stratum1F3 Name_St1

SHORT Stratum2F1 Name_St2
SHORT Stratum2F2 Name_St2
SHORT Stratum2F3 Name_St2

SHORT Stratum3F1 Name_St3
SHORT Stratum3F2 Name_St3
SHORT Stratum3F3 Name_St3
SHORT Stratum3F4 Name_St3

SHORT Stratum4F1 Name_St4
SHORT Stratum4F2 Name_St4
SHORT Stratum4F3 Name_St4
SHORT Stratum4F4 Name_St4

SHORT Stratum5AF1 Name_St5A
SHORT Stratum5AF2 Name_St5A
SHORT Stratum5AF3 Name_St5A
SHORT Stratum5AF4 Name_St5A
SHORT Stratum5AF5 Name_St5A

SHORT Stratum5BF1 Name_St5B
SHORT Stratum5BF2 Name_St5B
SHORT Stratum5BF3 Name_St5B
SHORT Stratum5BF4 Name_St5B
SHORT Stratum5BF5 Name_St5B

SHORT Stratum5CF1 Name_St5C
SHORT Stratum5CF2 Name_St5C
SHORT Stratum5CF3 Name_St5C
SHORT Stratum5CF4 Name_St5C

SHORT Stratum6F1 Name_St6C
SHORT Stratum6F2 Name_St6C
SHORT Stratum6F3 Name_St6C
SHORT Stratum6F4 Name_St6C
SHORT Stratum6F5 Name_St6C
SHORT Stratum6F6 Name_St6C
SHORT Stratum6F7 Name_St6C
SHORT Stratum6F8 Name_St6C

SHORT HirschringSquare Label_City
SHORT Guildhall Label_City
WORD 0x0

ALIGN 4

#ifndef HAX_ACTION_APPLICATION_REWORK_EVENT
#define HAX_ACTION_APPLICATION_REWORK_EVENT

#ifndef _FE8_
	ERROR _file_ is to be assembled for FE8
#endif // _FE8_

#include "Extensions/Hack Installation.txt"
#include "EAstdlib.event"

PUSH; ORG 0x3200C	
	replaceWithHack(prNewActionApplication)
POP

ALIGN 4
prNewActionApplication:
	#incbin "asm/ApplyAction.bin"
	POIN pActionRoutineTable

ALIGN 4
prWaitAction:
	#incbin "asm/WaitAction.bin"

#ifndef ACTION_TABLE_SIZE
	#define ACTION_TABLE_SIZE 0x30
#endif

#define NoActionRoutine "WORD 0"
#define ActionRoutine(apRoutine) "POIN apRoutine"
#define ActionRoutine(apRoutine, abForcedYeild) "WORD (0x08000000 | apRoutine | (abForcedYeild << 28))"

#define SetUnitAction(aActionId, adActionRoutine) "PUSH; ORG (pActionRoutineTable + 4*aActionId); adActionRoutine; POP"

pActionRoutineTable:
	NoActionRoutine               // 0x00 ?
	ActionRoutine(prWaitAction+1) // 0x01 Wait
	ActionRoutine(0x3229D)        // 0x02 Combat
	ActionRoutine(0x2FC49, True)  // 0x03 Staff
	ActionRoutine(0x32359)        // 0x04 Dance
	NoActionRoutine               // 0x05 ?
	ActionRoutine(0x3247D)        // 0x06 Steal
	ActionRoutine(0x32555)        // 0x07 Summon
	ActionRoutine(0x32581)        // 0x08 Summon DK
	ActionRoutine(0x32165)        // 0x09 Rescue
	ActionRoutine(0x321E1)        // 0x0A Drop
	NoActionRoutine               // 0x0B Take
	NoActionRoutine               // 0x0C Give
	NoActionRoutine               // 0x0D ? (Used by Teq in one of his hacks)
	ActionRoutine(0x323A9)        // 0x0E Talk
	ActionRoutine(0x323D5)        // 0x0F Support
	ActionRoutine(0x32271)        // 0x10 Visit
	ActionRoutine(0x32271)        // 0x11 Sieze
	ActionRoutine(0x2FC49, True)  // 0x12 Door
	NoActionRoutine               // 0x13 ?
	ActionRoutine(0x2FC49, True)  // 0x14 Chest
	ActionRoutine(0x2FFB5, True)  // 0x15 Pick
	NoActionRoutine               // 0x16 ?
	NoActionRoutine               // 0x17 Post Shopping
	NoActionRoutine               // 0x18 ?
	ActionRoutine(0x32345)        // 0x19 Arena
	ActionRoutine(0x2FC49, True)  // 0x1A Use Item
	NoActionRoutine               // 0x1B ?
	NoActionRoutine               // 0x1C ?
	NoActionRoutine               // 0x1D Post Trade/Supply
	NoActionRoutine               // 0x1E Wait 2 (needs more research)
	NoActionRoutine               // 0x1F Backing out (from a trap?)
	NoActionRoutine               // 0x20 ?
	NoActionRoutine               // 0x21 Ride Ballista
	NoActionRoutine               // 0x22 Exit Ballista
	NoActionRoutine     // 0x23 ACTION_MOVETARGET
	ActionRoutine(SwapAction)     // 0x24 ACTION_MOVEACTIVE
	ActionRoutine(PivotAction)               // 0x25 ACTION_SWAP
	ActionRoutine(SmiteAction)               // 0x26 ACTION_PUSH
	ActionRoutine(RepositionAction)               // 0x27 ACTION_SWARP
	ActionRoutine(DrawBackAction) // 0x28 
	ActionRoutine(TargetMarkAction) // 0x29
	NoActionRoutine               // 0x2A FREE
	NoActionRoutine               // 0x2B FREE
	NoActionRoutine               // 0x2C FREE
	NoActionRoutine               // 0x2D FREE
	NoActionRoutine               // 0x2E FREE
	NoActionRoutine               // 0x2F FREE etc...

ORG (pActionRoutineTable+ACTION_TABLE_SIZE*4)

ALIGN 4
SwapActID_Link: 
WORD 0x24
ALIGN 4
PivotActID_Link: 
WORD 0x25
ALIGN 4
SmiteActID_Link: 
WORD 0x26
ALIGN 4
RepositionActID_Link: 
WORD 0x27
ALIGN 4
DrawBackActID_Link: 
WORD 0x28
ALIGN 4
TargetMarkActID_Link: 
WORD 0x29
ALIGN 4
SwapTargetBottomText_Link: 
WORD SwapTargetBottomText
ALIGN 4
PivotTargetBottomText_Link: 
WORD PivotTargetBottomText
ALIGN 4
SmiteTargetBottomText_Link: 
WORD SmiteTargetBottomText
ALIGN 4
RepositionTargetBottomText_Link: 
WORD RepositionTargetBottomText
ALIGN 4
DrawBackTargetBottomText_Link: 
WORD DrawBackTargetBottomText
ALIGN 4
TargetMarkTargetBottomText_Link: 
WORD TargetMarkTargetBottomText
ALIGN 4
BuffDebuffTargetBottomText_Link: 
WORD BuffDebuffTargetBottomText


ALIGN 4
gBuffDebuffTargetSelection: 
POIN BuffDebuffTargetInit // Init
POIN 0x0804E885 // End
POIN 0x00000000 // Init Target
POIN 0x080247D1 // Switch In
POIN 0x00000000 // Switch Out
POIN BuffDebuffTargetAPress // A Press
POIN 0x08022749 // B Press
POIN 0x00000000 // R Press
ALIGN 4
gTargetMarkTargetSelection: 
POIN TargetMarkTargetInit // Init
POIN 0x0804E885 // End
POIN 0x00000000 // Init Target
POIN 0x080247D1 // Switch In
POIN 0x00000000 // Switch Out
POIN TargetMarkTargetAPress // A Press
POIN 0x08022749 // B Press
POIN 0x00000000 // R Press
ALIGN 4
gSwapTargetSelection: 
POIN SwapTargetInit // Init
POIN 0x0804E885 // End
POIN 0x00000000 // Init Target
POIN 0x080247D1 // Switch In
POIN 0x00000000 // Switch Out
POIN SwapTargetAPress // A Press
POIN 0x08022749 // B Press
POIN 0x00000000 // R Press
ALIGN 4
gPivotTargetSelection: 
POIN PivotTargetInit // Init
POIN 0x0804E885 // End
POIN 0x00000000 // Init Target
POIN 0x080247D1 // Switch In
POIN 0x00000000 // Switch Out
POIN PivotTargetAPress // A Press
POIN 0x08022749 // B Press
POIN 0x00000000 // R Press
ALIGN 4
gSmiteTargetSelection: 
POIN SmiteTargetInit // Init
POIN 0x0804E885 // End
POIN 0x00000000 // Init Target
POIN 0x080247D1 // Switch In
POIN 0x00000000 // Switch Out
POIN SmiteTargetAPress // A Press
POIN 0x08022749 // B Press
POIN 0x00000000 // R Press
ALIGN 4
gRepositionTargetSelection: 
POIN RepositionTargetInit // Init
POIN 0x0804E885 // End
POIN 0x00000000 // Init Target
POIN 0x080247D1 // Switch In
POIN 0x00000000 // Switch Out
POIN RepositionTargetAPress // A Press
POIN 0x08022749 // B Press
POIN 0x00000000 // R Press
ALIGN 4
gDrawBackTargetSelection: 
POIN DrawBackTargetInit // Init
POIN 0x0804E885 // End
POIN 0x00000000 // Init Target
POIN 0x080247D1 // Switch In
POIN 0x00000000 // Switch Out
POIN DrawBackTargetAPress // A Press
POIN 0x08022749 // B Press
POIN 0x00000000 // R Press

#endif // HAX_ACTION_APPLICATION_REWORK_EVENT


ALIGN 4
#define SetDefaultName(textID) "BYTE 0x40 0x0D ; SHORT textID; POIN DefaultNameFunction+1"
DefaultNameFunction:
#incbin "CopyTactName.dmp"

//return 1 to slot C if match, use to refuse naming guild Piorin
ALIGN 4
#define CheckName(textID) "BYTE 0x40 0x0D ; SHORT textID; POIN CheckNameFunction+1"
CheckNameFunction:
#incbin "StrcmpTactName.dmp"


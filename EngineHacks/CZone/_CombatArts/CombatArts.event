	CA_Prebattle(pointer); CA_BothSides(pointer); CA_Postbattle(pointer)
	CA_BattleProc(pointer); CA_HitCount(pointer); CA_Odds(pointer)
	CA_Range(pointer); CA_IsMagic(value); CA_SpellAnim(value); CA_ItemEffect(value)
*/


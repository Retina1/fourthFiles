#include "Config.event"

#define StrVsResArt 2
#define MagicArt 1
#define PhysArt 0
#define NullArt 0
#define Set1LastArt 66
#define Set2LastArt 110
#define Set3LastArt 154
#define Set4LastArt 198
#define Set5LastArt 220
#define Set6LastArt 253
#define Set7LastArt 275
#define Set8LastArt 297

ALIGN 4
LastArtInTable:
WORD Set8LastArt

ALIGN 4; CAMenuDef:
BYTE 0 3 10 0; WORD 0 CAS_RAM_START 0 0 0; POIN 0x22861 0x4F521 0x4F459


// Item select menu when selecting a non-combat combat art
ALIGN 4; CAS_ItemSelectMenuDef:
BYTE 1 1 14 0; WORD 0; POIN CAS_ItemSelectMenuItems; WORD 0 0 0; POIN 0x22861 0x4F521 0x24589

ALIGN 4; CAS_ItemSelectMenuItems:
WORD 0 0; BYTE 0 0x3E; ALIGN 4; POIN CAS_ItemSelectMenu_Usability CAS_ItemSelectMenu_Draw CAS_ItemSelectMenu_Effect 0 0x23C15 0x23C69
WORD 0 0; BYTE 0 0x3F; ALIGN 4; POIN CAS_ItemSelectMenu_Usability CAS_ItemSelectMenu_Draw CAS_ItemSelectMenu_Effect 0 0x23C15 0x23C69
WORD 0 0; BYTE 0 0x40; ALIGN 4; POIN CAS_ItemSelectMenu_Usability CAS_ItemSelectMenu_Draw CAS_ItemSelectMenu_Effect 0 0x23C15 0x23C69
WORD 0 0; BYTE 0 0x41; ALIGN 4; POIN CAS_ItemSelectMenu_Usability CAS_ItemSelectMenu_Draw CAS_ItemSelectMenu_Effect 0 0x23C15 0x23C69
WORD 0 0; BYTE 0 0x42; ALIGN 4; POIN CAS_ItemSelectMenu_Usability CAS_ItemSelectMenu_Draw CAS_ItemSelectMenu_Effect 0 0x23C15 0x23C69
WORD 0 0 0 0 0 0 0 0 0

#define CombatArt(id,name, desc, durabilityCost, usability, menu_usability, menu_draw, menu_effect, prebattle, bothsides, postbattle, battleproc, rangefunc, oddsfunc, hitcount, isMagic, spellAnim, itemEffect) \
"PUSH; ORG CombatArtList+(id*0x40); \
SHORT name desc; POIN usability menu_usability menu_draw menu_effect prebattle bothsides postbattle battleproc rangefunc oddsfunc hitcount; BYTE isMagic spellAnim itemEffect 0; \
ORG CombatArtDurabilityList+id; BYTE durabilityCost; POP"

#define CA_Entry(id, cost) "ORG CombatArtList+(id*0x40); PUSH; ORG CombatArtDurabilityList+id; BYTE cost; POP"
#define CA_Name(name,desc) "PUSH; ORG CURRENTOFFSET + 0; SHORT name desc; POP"
#define CA_Usability(use,menu_use) "PUSH; ORG CURRENTOFFSET + 4; POIN use menu_use 0; POP"
#define CA_Effect(effect) "PUSH; ORG CURRENTOFFSET + 16; POIN effect; POP"
#define CA_GeneralAttackEffect "PUSH; ORG CURRENTOFFSET + 16; POIN CombatArtGeneralAttackingEffect; POP"
#define CA_GeneralNonCombatEffect "PUSH; ORG CURRENTOFFSET + 16; POIN GeneralNonCombatMenuEffect; POP"
#define CA_ItemSelectUsability(effect) "PUSH; ORG CURRENTOFFSET + 20; POIN effect; POP"
#define CA_ItemSelectEffect(effect) "PUSH; ORG CURRENTOFFSET + 24; POIN effect; POP"
#define CA_Prebattle(pointer) "PUSH; ORG CURRENTOFFSET + 28; POIN pointer; POP"
#define CA_BothSides(pointer) "PUSH; ORG CURRENTOFFSET + 32; POIN pointer; POP"
#define CA_Postbattle(pointer) "PUSH; ORG CURRENTOFFSET + 36; POIN pointer; POP"
#define CA_BattleProc(pointer) "PUSH; ORG CURRENTOFFSET + 40; POIN pointer; POP"
#define CA_Range(pointer) "PUSH; ORG CURRENTOFFSET + 44; POIN pointer; POP"
#define CA_Odds(pointer) "PUSH; ORG CURRENTOFFSET + 48; POIN pointer; POP"
#define CA_HitCount(pointer) "PUSH; ORG CURRENTOFFSET + 52; POIN pointer; POP"
#define CA_HealAmount(pointer) "PUSH; ORG CURRENTOFFSET + 56; POIN pointer; POP"
#define CA_IsMagic(value) "PUSH; ORG CURRENTOFFSET + 60; BYTE value; POP"
#define CA_SpellAnim(value) "PUSH; ORG CURRENTOFFSET + 61; BYTE value; POP"
#define CA_ItemEffect(value) "PUSH; ORG CURRENTOFFSET + 62; BYTE value; POP"
#define CA_IER(value) "PUSH; ORG CURRENTOFFSET + 63; BYTE value; POP"

#define CA_Ailment(pointer,value) "CA_Odds(pointer); CA_ItemEffect(value)"
#define CA_GenericStance "CA_Range(HideRange); CA_ItemSelectEffect(GenericStanceItemSelectEffect); CA_IER(0x3a); CA_SpellAnim(0x66)"



ALIGN 4; CombatArtList: FILL 0x40*0x181
ALIGN 4; CombatArtDurabilityList: FILL 0x181

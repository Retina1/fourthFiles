PUSH
#include "Set1_Initial.event"
#include "Set2_Standard.event"
#include "Set3_Magi.event"
#include "Set4_Special.event"
#include "Set5_Skyshroud.event"
#include "Set6_Lifeflow.event"
#include "Set7_Senatus.event"
#include "Set8_ImpArt.event"

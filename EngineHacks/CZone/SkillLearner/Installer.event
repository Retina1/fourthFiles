#include "EAstdlib.event" 

// skill stuff
// adapted from vesly's convo viewer, commed by me

ALIGN 4 
SkillsetEntry: 
FILL(4*0xFF) 
ORG SkillsetEntry 
POIN 0
POIN SwordfighterSkillLabels
POIN KnightSkillLabels
POIN AxefighterSkillLabels
POIN ArcherSkillLabels
POIN ScholarSkillLabels
POIN MedicSkillLabels
POIN MyrmidonSkillLabels
POIN RiderSkillLabels
POIN RaiderSkillLabels
POIN GunnerSkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN DarkHunterSkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN NobleSkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN SkillLabels
POIN 0 


ORG SkillsetEntry+(4*0xFF)
ALIGN 4
#define OneLevelSkillLabel(skillName,prereqs) "SHORT skillName skillName+1 skillName+2 0 0 0 0 0x0; POIN prereqs"
#define TwoLevelSkillLabel(skillName,prereqs) "SHORT skillName skillName+1 skillName+2 skillName+3 0 0 0 0x0; POIN prereqs"
#define ThreeLevelSkillLabel(skillName,prereqs) "SHORT skillName skillName+1 skillName+2 skillName+3 skillName+4 0 0 0x0; POIN prereqs"
#define FiveLevelSkillLabel(skillName,prereqs) "SHORT skillName skillName+1 skillName+2 skillName+3 skillName+4 skillName+5 skillName+6 0x0; POIN prereqs"

#define ReqEntry(skillnumber,level) "SHORT (level+skillnumber*0x100)"
#define ReqPromo "BYTE 0xFF 0xFF"
#define ReqTerm "BYTE 0x0 0x0"

//keeping this for legacy support
#define TwoLevelSkillLabel(skillName,desc0,desc1,desc2,prereqs) "SHORT skillName desc0 desc1 desc2 0 0 0 0x0; POIN prereqs"
#define CommonSkillsLabels "TwoLevelSkillLabel(HPUpSkill,HPUpDesc0,HPUpDesc1,HPUpDesc2,NoReq);TwoLevelSkillLabel(StrUpSkill,StrUpDesc0,StrUpDesc1,StrUpDesc2,NoReq);TwoLevelSkillLabel(MagUpSkill,MagUpDesc0,MagUpDesc1,MagUpDesc2,NoReq);TwoLevelSkillLabel(SklUpSkill,SklUpDesc0,SklUpDesc1,SklUpDesc2,NoReq);TwoLevelSkillLabel(SpdUpSkill,SpdUpDesc0,SpdUpDesc1,SpdUpDesc2,NoReq);TwoLevelSkillLabel(LucUpSkill,LucUpDesc0,LucUpDesc1,LucUpDesc2,NoReq);TwoLevelSkillLabel(DefUpSkill,DefUpDesc0,DefUpDesc1,DefUpDesc2,NoReq);TwoLevelSkillLabel(ResUpSkill,ResUpDesc0,ResUpDesc1,ResUpDesc2,NoReq)"
#define SkillLabelTerminator "CommonSkillsLabels; SHORT 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0; POIN 0"

PromotedReq:
ReqPromo
ReqTerm
ALIGN 4
NoReq:
ReqTerm


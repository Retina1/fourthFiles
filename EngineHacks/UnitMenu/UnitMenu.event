  MenuCommand(UM_SwordStance, UM_SwordStanceDesc, OrangeText, SwordStance_Usability, SwordStance_Effect)
  MenuCommand(UM_GracefulBlur, UM_GracefulBlurDesc, OrangeText, GracefulBlur_Usability, GracefulBlur_Effect)
  MenuCommand(UM_Swap, UM_SwapDesc, OrangeText, Swap_Usability, Swap_Effect)
  MenuCommand(UM_Pivot, UM_PivotDesc, OrangeText, Pivot_Usability, Pivot_Effect)
  MenuCommand(UM_Smite, UM_SmiteDesc, OrangeText, Smite_Usability, Smite_Effect)
  MenuCommand(UM_Reposition, UM_RepositionDesc, OrangeText, Reposition_Usability, Reposition_Effect)
  MenuCommand(UM_DrawBack, UM_DrawBackDesc, OrangeText, DrawBack_Usability, DrawBack_Effect)

  UM_Item
  UM_Trade
  UM_Supply //MenuCommand(0x68F,0x6D5,GreenText,NewSupplyUsability,0x23FB8)
  UM_Armory
  UM_Vendor
  UM_Arena
  MenuCommand(0x681, 0x6ca, BlueText, SkillLearner_Usability|1, SkillLeveler_OnSelect|1) // UM_Custom
  UM_Wait
  UM_Separator 
  
  
  //work in ditto system

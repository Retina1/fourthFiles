  UM_Pick
  MenuCommand(0x680, 0x6c9, GreenText, 0x23c81, 0x23cc5) // UM_Talk
  UM_Visit 
  UM_Rescue
  UM_Give
  UM_Take
  UM_Drop
  //todo - make these have smoother animations?

//nob
PaletteIdentifier(Noble_Benthus, Noble_BenthusDMP)
PaletteIdentifier(Sovereign_Benthus, Sovereign_BenthusDMP)
ALIGN 4
Noble_BenthusDMP:
#incbin "paletteFiles/MainStory/Noble_Benthus.dmp"
ALIGN 4
Sovereign_BenthusDMP:
#incbin "paletteFiles/MainStory/Sovereign_Benthus.dmp"

ALIGN 4
NoblePaletteList:
PaletteAssociationEntry(Benthus,Noble_Benthus)
PaletteAssociationEntry(BossBenthus,Noble_Benthus)
PaletteAssociationEntry(BossBenthus2,Noble_Benthus)
WORD 0 0
ALIGN 4
SovereignPaletteList:
PaletteAssociationEntry(Benthus,Sovereign_Benthus)
PaletteAssociationEntry(BossBenthus,Sovereign_Benthus)
PaletteAssociationEntry(BossBenthus2,Sovereign_Benthus)
WORD 0 0


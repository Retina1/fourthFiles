//nob
PaletteIdentifier(Benthus_Noble, Benthus_NobleDMP)
PaletteIdentifier(Benthus_Sovereign, Benthus_SovereignDMP)
ALIGN 4
Benthus_NobleDMP:
#incbin "paletteFiles/MainStory/Benthus_Noble.dmp"
ALIGN 4
Benthus_SovereignDMP:
#incbin "paletteFiles/MainStory/Benthus_Sovereign.dmp"

ALIGN 4
NoblePaletteList:
PaletteAssociationEntry(Benthus,Benthus_Noble)
PaletteAssociationEntry(BossBenthus,Benthus_Noble)
PaletteAssociationEntry(BossBenthus2,Benthus_Noble)
WORD 0 0
ALIGN 4
SovereignPaletteList:
PaletteAssociationEntry(Benthus,Benthus_Sovereign)
PaletteAssociationEntry(BossBenthus,Benthus_Sovereign)
PaletteAssociationEntry(BossBenthus2,Benthus_Sovereign)
WORD 0 0


//use braces here to avoid name conflicts. If you don't know what that means, surround all #includes in this files in braces like done below.
#include "REDAs.event"

	PUSH
	ORG $A39768
	EVBIT_MODIFY 0x1
	SKIPWN
	ENDA
	POP
	
#define SetUnitStatline(unit,mhp,str,mag,skl,spd,luk,def,res) "SetUnitStatus(unit,MaxHP,mhp);SetUnitStatus(unit,CurrentHP,mhp);SetUnitStatus(unit,Strength,str);SetUnitStatus(unit,Magic,mag);SetUnitStatus(unit,Skill,skl);SetUnitStatus(unit,Speed,spd);SetUnitStatus(unit,LuckStat,luk);SetUnitStatus(unit,Defence,def);SetUnitStatus(unit,Resistance,res)"
#define SetUnitWEXP(unit,swd,lnc,axe,bow,stf) "SetUnitStatus(unit,SwordExp,swd);SetUnitStatus(unit,LanceExp,lnc);SetUnitStatus(unit,AxeExp,axe);SetUnitStatus(unit,BowExp,bow);SetUnitStatus(unit,StaffExp,stf)"

	
#define AreaEvent(eventID,EventPointer,corner1x,corner1y,corner2x,corner2y)   "AREA eventID EventPointer [corner1x,corner1y] [corner2x,corner2y]" 
#define AreaEvent(flag,label,x,y) "AreaEvent(flag,label,x,y,x,y)"
	
#define LoadUnitsByDifficulty(easy,normal,hard) "CHECK_TUTORIAL ; BNE 4034 rC r0 ; CHECK_HARD ; BNE 4035 rC r0 ; LOAD1 0x1 normal ; GOTO 4036 ; LABEL 4034 ; LOAD1 0x1 easy ; GOTO 4036 ; LABEL 4035 ; LOAD1 0x1 hard ; LABEL 4036 ; ENUN;"
#define SystemText(textid) "CenterTutorialTextBox; TUTORIALTEXTBOXSTART; TEXTSHOW textid; TEXTEND; REMA"
#define SoloText(textid) "CenterTutorialTextBox; SOLOTEXTBOXSTART; TEXTSHOW textid; TEXTEND; REMA"
#define SystemText(bgid,textid) "CenterTutorialTextBox; SetBackground(bgid); TUTORIALTEXTBOXSTART; TEXTSHOW textid; TEXTEND; FADI 16"
#define EndEvent "EVBIT_T 0x7; ENDA"
#define CleanTextNoMap(bgid,textid) "SetBackground(bgid); TEXTSTART; TEXTSHOW textid; TEXTEND; FADI 16"
#define CleanText(bgid,textid) "SetBackground(bgid); TEXTSTART; TEXTSHOW textid; TEXTEND; ClearBackgroundSmooth"
#define CGText(textid) "CGTEXTSTART; TEXTSHOW textid; TEXTEND"
#define GiveItem(item) "SMOV 0x3 item; GIVEITEMTO 0xFFFF;"
#define GiveItem(item,character) "SMOV 0x3 item; GIVEITEMTO character;"
#define GiveItem(item,uses,character) "SMOV 0x3 uses*0x100+item; GIVEITEMTO character;"
#define CamOn "EVBIT_T 9"
#define CamOff "EVBIT_F 9"
#define StartGameOver "ASMC 0x800D391" // Game over ASMC 
#define RefreshSMS "ASMC 0x8026689" //see how this looks when loading stuff
#define RefreshLordSplitTiles "ASMC 0x8003D21" //see how this looks when loading stuff
#define Reinforcements(pointer) "CamOn ; LOAD1 0x0 pointer; ENUN; RefreshSMS; ASMC RefreshHPCacheASMC|1; CamOff"
#define HardReinforcements(pointer) "CHECK_HARD ; BNE 6789 rC r0 ; Reinforcements(pointer); LABEL 6789"
#define DifficultyReinforcements(easy,normal,hard) "CHECK_TUTORIAL ; BNE 4034 rC r0 ; CHECK_HARD ; BNE 4035 rC r0 ; Reinforcements(normal) ; GOTO 4036 ; LABEL 4034 ; Reinforcements(easy) ; GOTO 4036 ; LABEL 4035 ; Reinforcements(hard) ; LABEL 4036 ; ENUN;"
#define RemoveUnit(unit) "CHECK_EXISTS unit; BEQ unit 0xc 0x0; REMU unit; LABEL unit"
#define UnremoveUnit(unit) "CHECK_EXISTS unit; BEQ unit 0xc 0x0; REVEAL unit; LABEL unit"
#define TurnAllyIfAlive(unit) "CHECK_ALIVE unit; BEQ unit 0xc 0x0; TurnAlly(unit); LABEL unit"
#define SilentKillUnit(unit) "DISA_IF unit; DISA unit"
#define SFXKillUnit(unit) "SET_SOMETHING unit; DISA unit"
#define DisaIfDead(unit) "CHECK_ALIVE unit; BNE unit 0xc 0x0; DISA unit; LABEL unit"
#define CallPreps "ENUF HideIconsFlag; CALL $591FD8"
#define RefreshLightRunes "ASMC 0x080271A1"
#define EndingSceneToggles "ENUT HideIconsFlag; SET_ACTIVE 0"

#define CreateArenaBorders(x1,y1,x2,y2) "SVAL 0x1 x1; SVAL 0x2 x2; SVAL 0x3 y1; SVAL 0x4 y2; ASMC TilemapBordersASMC|1;  AddTrap(LightRuneTrapID,x1,y1);AddTrap(LightRuneTrapID,x2,y1);AddTrap(LightRuneTrapID,x1,y2);AddTrap(LightRuneTrapID,x2,y2);RefreshLightRunes"
#define CreateArenaSingleCorner(x,y) "SVAL 0x1 x; SVAL 0x2 y; ASMC TilemapBordersSingleCornerASMC|1;AddTrap(LightRuneTrapID,x,y);RefreshLightRunes"
//second clears traps
#define ClearArenaBorders "ASMC ClearLightRunes|1; RefreshLightRunes; ASMC 0x8019A65; ASMC HealPlayersASMC|1"
#define ResetTurncount "SVAL 1 1; ASMC SetTurncountASMC|1"
#define BeginCombatEncounter "ResetTurncount; ASMC RepairModeRefreshASMC|1; ENUF 0x6; ENUF WaitEventTrapsFlag; FADI 16; CLEA 0"
#define WarpNathan(x,y)	"SET_ACTIVE Nathan; SVAL 0x2 Nathan; CALL 0x9EE51C; WM_WAITFORFX; CAM1 [x,y]; WM_WAITFORCAM; SVAL 0xB y*0x10000+x; WARP_IN; STAL 20; MOVE 0xFFFF Nathan [x,y]; ENUN; WM_WAITFORFX; STAL 12; NathanIsHere"
#define SilentWarpNathan(x,y)	"SET_ACTIVE Nathan; FADI 16; CAM1 [x,y]; WM_WAITFORCAM; MOVE 0xFFFF Nathan [x,y]; ENUN; FADU 16"

#define DifficultySwapper "ENUT HideIconsFlag; EVBIT_MODIFY 4; CALL DifficultySwapEvent; ASMC RepairModeRefreshASMC|1; EVBIT_MODIFY 0"

#define LevelUpSkill(unitID,skillID) "SVAL 0x1 unitID; SVAL 0x2 skillID; ASMC LevelUpSkillASMC|1"
#define DumpUnitItems(unit) "SVAL 0x1 unit; ASMC DumpUnitItemsASMC|1"

//ending turncounts
//ASMC 0xB8175

#include "_BattleQuotes.event"
#include "_DeathQuotes.event"
#include "_ConditionalDrops.event"
#include "_BossMusic.event"
#include "_ForceDeployer.event"
#include "WorldMapEvents.event"
#include "LordSplitMenus/LordSplitMenuPlus.event"


DifficultySwapEvent:
SetBackground(0x35)

SystemText(DifficultyModifierPrompt)
IfNoSelectedGoto(0x1)
ASMC DifficultyChooser_OnSelect|1

CALL CampaignCustomizers

LABEL 0x1

SystemText(DEBUGPrompt)
IfNoSelectedGoto(0x10)
SystemText(DEBUGAutolevelPrompt)
IfNoSelectedGoto(0x2)
ASMC ValueChooser_OnSelect|1
ASMC AutoLevelAllASMC|1
LABEL 0x2

SystemText(DEBUGCharacterLoadPrompt)
IfNoSelectedGoto(0x6)
ASMC DebugUnitChooser_OnSelect|1
LABEL 0x6


SystemText(DEBUGClassUnlockPrompt)
IfNoSelectedGoto(0x5)
ENUT StandardUnlockedFlag
ENUT MagiUnlockedFlag
ENUT SpecialUnlockedFlag
ENUT SkyUnlockedFlag
ENUT LifeflowUnlockedFlag
ENUT SenatusUnlockedFlag
ENUT OtherUnlockedFlag
LABEL 0x5

/*
SystemText(DEBUGClassChangePrompt)
IfNoSelectedGoto(0x3)
ASMC ValueChooser_OnSelect|1
ASMC ChangeAllClassASMC|1
LABEL 0x3

SystemText(DEBUGCharacterChangePrompt)
IfNoSelectedGoto(0x4)
ASMC ValueChooser_OnSelect|1
ASMC ChangeAllCharacterASMC|1
LABEL 0x4
*/

LABEL 0x10
FADI 16
CLEAN
//FADU 16
ENDA


CampaignCustomizers:
SystemText(CampaignCustomPrompt)
IfNoSelectedGoto(0x3000)
SystemText(RTextExplanation)
LABEL 0x1000
RefreshLordSplitTiles
ENUF FIXED_GROWTHS_FLAG_ID; ENUF ZERO_GROWTHS_FLAG_ID; ENUF MIN_GROWTHS_FLAG_ID; ENUF MAX_GROWTHS_FLAG_ID
CallMenu(GrowthModeMenu)
//normal
	SVAL 0x1 0x0
	BNE 0x1 0xc 0x1
		SystemText(NormalGrowthsConfirm)
		IfNoSelectedGoto(0x1000)
		GOTO 0x2000
	LABEL 0x1
//fixed
	SVAL 0x1 0x1
	BNE 0x2 0xc 0x1
		SystemText(FixedGrowthsConfirm)
		IfNoSelectedGoto(0x1000)
		ENUT FIXED_GROWTHS_FLAG_ID
		GOTO 0x2000
	LABEL 0x2
//zero
	SVAL 0x1 0x2
	BNE 0x3 0xc 0x1
		SystemText(ZeroGrowthsConfirm)
		IfNoSelectedGoto(0x1000)
		ENUT ZERO_GROWTHS_FLAG_ID
		GOTO 0x2000
	LABEL 0x3
//min
	SVAL 0x1 0x3
	BNE 0x4 0xc 0x1
		SystemText(MinimumGrowthsConfirm)
		IfNoSelectedGoto(0x1000)
		ENUT MIN_GROWTHS_FLAG_ID
		GOTO 0x2000
	LABEL 0x4
//max
	SVAL 0x1 0x4
	BNE 0x5 0xc 0x1
		SystemText(MaxGrowthsConfirm)
		IfNoSelectedGoto(0x1000)
		ENUT MAX_GROWTHS_FLAG_ID
		GOTO 0x2000
	LABEL 0x5
LABEL 0x2000
ENUT 0x8
ENUT 0x9
ENUT 0xa
LABEL 0x2001
CallMenu(CustomizersMenu)
	SVAL 0x1 0x0
	BNE 0x10 0xc 0x1
		SystemText(PicnicModeConfirm)
		IfNoSelectedGoto(0x2001)
		ENUT PicnicModeFlag
		ENUF 0x8
		GOTO 0x2001
	LABEL 0x10

	SVAL 0x1 0x1
	BNE 0x11 0xc 0x1
		SystemText(RepairModeConfirm)
		IfNoSelectedGoto(0x2001)
		ENUT RepairModeFlag
		ENUF 0x9
		GOTO 0x2001
	LABEL 0x11

	SVAL 0x1 0x2
	BNE 0x12 0xc 0x1
		SystemText(ColorblindConfirm)
		IfNoSelectedGoto(0x2001)
		ENUT ColorblindFlag
		ENUF 0xa
		GOTO 0x2001
	LABEL 0x12

	SVAL 0x1 0x3
	BNE 0x13 0xc 0x1
		SystemText(ClearModifiers)
		ENUF PicnicModeFlag
		ENUF RepairModeFlag
		ENUF ColorblindFlag
		GOTO 0x2000
	LABEL 0x13
LABEL 0x3000
ENUF 0x8
ENDA

//GAME OVER STUFF
PUSH
ORG $837B8
BYTE 0x0
ORG $837CA
SHORT 0x0

ORG 0x592104
CALL NewGameOverEvent
ENDA

POP


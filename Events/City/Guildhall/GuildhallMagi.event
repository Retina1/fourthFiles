GuildLoad(Nadja,Recruit_Nadja,0x2)
GuildLoad(Levia,Recruit_Levia,0x3,Chapter8DoneFlag)
GuildLoad(Vasily,Recruit_Vasily,0x4)
GuildLoad(Jebet,Recruit_Jebet,0x5)
GuildLoad(Wont,Recruit_Wont,0x6)
FADU 10
ENDA

GuildhallLoadPriests:

GuildhallLoadPoets:
FADI 10; CLEN 0; LOAD1 0x0 BehindCounterGerson; LOAD1 0x0 GuildmasterCalledIn
GuildLoadFlagReset
GuildLoad(Leonzio,Recruit_Leonzio,0x1)
GuildLoad(Gunther,Recruit_Gunther,0x2)
GuildLoad(Jacqwil,Recruit_Jacqwil,0x3)
GuildLoad(Polymnia,Recruit_Polymnia,0x4)
GuildLoad(Lucien,Recruit_Lucien,0x5)
GuildLoad(Juliette,Recruit_Juliette,0x6,Chapter8DoneFlag)
FADU 10
ENDA

GuildhallLoadSeekers:
FADI 10; CLEN 0; LOAD1 0x0 BehindCounterGerson; LOAD1 0x0 GuildmasterCalledIn
GuildLoadFlagReset

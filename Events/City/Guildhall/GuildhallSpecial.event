GuildhallLoadDarkHunters:
FADI 10; CLEN 0; LOAD1 0x0 BehindCounterGerson; LOAD1 0x0 GuildmasterCalledIn
GuildLoadFlagReset
GuildLoad(Luis,Recruit_Luis,0x1)
GuildLoad(Notre,Recruit_Notre,0x2)
GuildLoad(Wund,Recruit_Wund,0x3,Chapter9DoneFlag)
GuildLoad(Peabody,Recruit_Peabody,0x4)
GuildLoad(Dalman,Recruit_Dalman,0x5)
GuildLoad(Noelle,Recruit_Noelle,0x6,SenatusUnlockedFlag)//ophelia unlocked
GuildLoad(Yasmine,Recruit_Yasmine,0x7)
FADU 10
ENDA


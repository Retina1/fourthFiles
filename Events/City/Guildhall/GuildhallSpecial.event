GuildhallSpecialMenuEvent:
CallMenu(RecruitSpecialMenu)
SVAL 0x1 0
BNE 0x2000 0xc 0x1
CALL GuildhallLoadDarkHunters
GOTO 0x2008
LABEL 0x2000
SVAL 0x1 1
BNE 0x2001 0xc 0x1
CALL GuildhallLoadLancers
GOTO 0x2008
LABEL 0x2001
SVAL 0x1 2
BNE 0x2002 0xc 0x1
CALL GuildhallLoadBrawlers
GOTO 0x2008
LABEL 0x2002
SVAL 0x1 3
BNE 0x2003 0xc 0x1
CALL GuildhallLoadHunters
GOTO 0x2008
LABEL 0x2003
SystemText(ErrorHandlerText)
LABEL 0x2008
ENDA
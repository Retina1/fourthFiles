GuildhallInitialMenuEvent:
CallMenu(RecruitInitialMenu)
SVAL 0x1 0
BNE 0x2000 0xc 0x1
CALL GuildhallLoadSwordfighters
GOTO 0x2008
LABEL 0x2000
SVAL 0x1 1
BNE 0x2001 0xc 0x1
CALL GuildhallLoadKnights
GOTO 0x2008
LABEL 0x2001
SVAL 0x1 2
BNE 0x2002 0xc 0x1
CALL GuildhallLoadAxefighters
GOTO 0x2008
LABEL 0x2002
SVAL 0x1 3
BNE 0x2003 0xc 0x1
CALL GuildhallLoadArchers
GOTO 0x2008
LABEL 0x2003
SVAL 0x1 4
BNE 0x2004 0xc 0x1
CALL GuildhallLoadScholars
GOTO 0x2008
LABEL 0x2004
SVAL 0x1 5
BNE 0x2005 0xc 0x1
CALL GuildhallLoadCurates
GOTO 0x2008
LABEL 0x2005
SystemText(ErrorHandlerText)
LABEL 0x2008
ENDA
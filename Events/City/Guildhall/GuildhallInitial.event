GuildhallLoadSwordfighters:
FADI 10; CLEN 0; LOAD1 0x0 BehindCounterGerson; LOAD1 0x0 GuildmasterCalledIn
GuildLoadFlagReset
GuildLoad(CoastKid,Recruit_CoastKid,0x1)
GuildLoad(Puzon,Recruit_Puzon,0x2)
GuildLoad(Cam,Recruit_Cam,0x3)
GuildLoad(Marag,Recruit_Marag,0x4,Chapter5DoneFlag)
FADU 10
ENDA

GuildhallLoadKnights:
FADI 10; CLEN 0; LOAD1 0x0 BehindCounterGerson; LOAD1 0x0 GuildmasterCalledIn
GuildLoadFlagReset
GuildLoad(Drogo,Recruit_Drogo,0x1)
GuildLoad(Gretchen,Recruit_Gretchen,0x2,Chapter5DoneFlag)
GuildLoad(Allbringer,Recruit_Allbringer,0x3)
GuildLoad(Hopf,Recruit_Hopf,0x4)
GuildLoad(SlynSpire,Recruit_SlynSpire,0x5)
GuildLoad(Alfonso,Recruit_Alfonso,0x6,Chapter8DoneFlag)
GuildLoad(Simon,Recruit_Simon,0x7)
FADU 10
ENDA


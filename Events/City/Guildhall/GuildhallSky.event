GuildhallLoadSkyKnights:
FADI 10; CLEN 0; LOAD1 0x0 BehindCounterGerson; LOAD1 0x0 GuildmasterCalledIn
GuildLoadFlagReset
GuildLoad(June,Recruit_June,0x1,Stratum3DoneFlag)
GuildLoad(Eneida,Recruit_Eneida,0x2)
GuildLoad(Patrice,Recruit_Patrice,0x3,Chapter10DoneFlag)
GuildLoad(Melody,Recruit_Melody,0x4)
GuildLoad(Anastas,Recruit_Anastas,0x5)
GuildLoad(Peregrine,Recruit_Peregrine,0x6)
GuildLoad(Mervyn,Recruit_Mervyn,0x7)
FADU 10
ENDA
GuildhallLoadScaleKnights:

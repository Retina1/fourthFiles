BlackMarketUnits:
//marketplpace npc, generics
UNIT FreelanceGeneric Caller 0x0 Level(6,NPC,1) [5,3] 0x0 0x0 0x0 0x0 [Vulnerary] NeverMoveAI
UNIT FreelanceGeneric Seeker 0x0 Level(8,NPC,1) [2,6] 0x0 0x0 0x0 0x0 [Vulnerary] NeverMoveAI
UNIT FreelanceGeneric Gunner 0x0 Level(7,NPC,1) [3,7] 0x0 0x0 0x0 0x0 [Vulnerary] NeverMoveAI
UNIT FreelanceGeneric Duelist 0x0 Level(13,NPC,1) [14,4] 0x0 0x0 0x0 0x0 [Vulnerary] NeverMoveAI
UNIT FreelanceGeneric Botanist 0x0 Level(15,NPC,1) [9,10] 0x0 0x0 0x0 0x0 [Vulnerary] NeverMoveAI
UNIT FreelanceGeneric Ronin 0x0 Level(18,NPC,1) [10,2] 0x0 0x0 0x0 0x0 [Vulnerary] NeverMoveAI
UNIT

//MESSAGE Events end at offset CURRENTOFFSET


ALIGN 4
LoadBlackMarketSigils:
ENUF LocationFlagBlackMarket
AddSigil(0,1)
AddSigil(0,2)
AddGreenSigil(9,3)
ENDA

//label 0x10 - broke
//label 0x20 - deny buy
#define BlackMarketHandler(item,cost,choice) "SVAL 0x1 choice; BNE choice 0xC 0x1; CHECK_MONEY; SVAL 0x1 cost; BLT 0x10 0xc 0x1; SetGtoMoney; Text(BlackPurchaseConfirm); IfNoSelectedGoto(0x20); SVAL 0x3 cost; TAKEMONEY; GiveItem(item,Nathan); GOTO 0x20; LABEL choice"
#define BlackMarketHandler(item,cost,choice,flag) "SVAL 0x1 choice; BNE choice 0xC 0x1; CHECK_MONEY; SVAL 0x1 cost; BLT 0x10 0xc 0x1; SetGtoMoney; Text(BlackPurchaseConfirm); IfNoSelectedGoto(0x20); SVAL 0x3 cost; TAKEMONEY; GiveItem(item,Nathan); ENUT flag; GOTO 0x20; LABEL choice"
#define BlackMarketHandler(item,uses,cost,choice,flag) "SVAL 0x1 choice; BNE choice 0xC 0x1; CHECK_MONEY; SVAL 0x1 cost; BLT 0x10 0xc 0x1; SetGtoMoney; Text(BlackPurchaseConfirm); IfNoSelectedGoto(0x20); SVAL 0x3 cost; TAKEMONEY; GiveItemWithDurability(item,uses,Nathan); ENUT flag; GOTO 0x20; LABEL choice"
#define BlackMarketHandlerUses(item,uses,cost,choice) "SVAL 0x1 choice; BNE choice 0xC 0x1; CHECK_MONEY; SVAL 0x1 cost; BLT 0x10 0xc 0x1; SetGtoMoney; Text(BlackPurchaseConfirm); IfNoSelectedGoto(0x20); SVAL 0x3 cost; TAKEMONEY; GiveItemWithDurability(item,uses,Nathan); GOTO 0x20; LABEL choice"
#define BlackBrokeHander "LABEL 0x10; SetGtoMoney; Text(BlackNotEnoughMoney); GOTO 0x20; LABEL 0x30"

BlackMarketLoopBegin:
EVBIT_MODIFY 3
Text(BlackMarketIntro)
LABEL 0x20
SetGtoMoney
CallMenu(BlackMarketMenu)
BlackMarketHandler(HandAxe,555,0)
BlackMarketHandler(SparkScroll,3600,1)
BlackMarketHandler(StoningGas,800,2)
BlackMarketHandler(Fengyan,1950,3)
BlackMarketHandlerUses(DvergrSword,1,250,4)
BlackMarketHandler(OmegaArch,6300,5)
BlackMarketHandler(Hippokos,2500,6,HippokosBoughtFlag)
BlackMarketHandler(SoulShield,65000,7)
GOTO 0x30
BlackBrokeHander
Text(BlackMarketEnd)
ENUF LocationFlagBlackMarket
EndEvent


BlackMarketMoveToNorthernPass:
SwapToMap(NorthernPass,15,17)
CALL LoadNorthernPassSigils
MUSC Song_VastLands
LoadPassUnits
FADU 10
EndEvent

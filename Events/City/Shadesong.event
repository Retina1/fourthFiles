ShadesongUnitsC5:
//marketplpace npc, generics
UNIT Rat 0x0 0x0 Level(1,Ally,0) [4,11] 0x0 0x0 0x0 0x0 [0x0] NeverMoveAI
UNIT

//MESSAGE Events end at offset CURRENTOFFSET


ALIGN 4
LoadShadesongSigils:
ENUF LocationFlagShadesong
AddSigil(0,3)
AddSigil(0,4)
ENDA

ShadesongMoveToShadyRow:
SwapToMap(ShadyRow,19,10)
CALL LoadShadyRowSigils
MUSC Song_VastLands
LoadRowUnits
FADU 10
EndEvent

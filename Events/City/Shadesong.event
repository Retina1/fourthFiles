//MESSAGE Events end at offset CURRENTOFFSET


ALIGN 4
LoadShadesongSigils:
ENUF LocationFlagShadesong
AddSigil(0,3)
AddSigil(0,4)
ENDA

ShadesongMoveToShadyRow:
SwapToMap(ShadyRow,19,10)
CALL LoadShadyRowSigils
MUSC Song_VastLands
LoadRowUnits
FADU 10
EndEvent

ShadesongDoor:
Text(PleaseDontOpenThatDoor)
ENUF 0x7
EndEvent
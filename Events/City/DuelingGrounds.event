ENUN
COUNTER_ADD 2 1
GOTO 0x105
LABEL 0x102
SVAL 2 4
BNE 0x103 0xc 2
//load level 5 here
FADI 10
CALL GroundsResetUnit
CHECK_EVENTID Arena3DoneFlag
BNE 0x66 0xc 0x0
	LOAD1 0 DuelingGroundsTier3Wave5
	GOTO 0x67
LABEL 0x66
LOAD1 0 DuelingGroundsTier3Wave5Alt
LABEL 0x67
ENUN
COUNTER_ADD 2 1
GOTO 0x105
LABEL 0x103
//done with course - first time victory reward
CHECK_EVENTID Arena3DoneFlag
BNE 0x200 0xc 0x0
ENUT Arena3DoneFlag
//give reward here
MUSC Song_FaithIsMyPillar

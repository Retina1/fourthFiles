//MESSAGE Events end at offset CURRENTOFFSET


ALIGN 4

LoadShadyRowSigils:
ENUF LocationFlagShadyRow
AddSigil(4,0)
AddSigil(5,0)
AddSigil(6,0)
AddSigil(13,1)
AddSigil(20,10)
AddSigil(25,0)
AddSigil(25,1)
AddSigil(25,2)
ENDA

ShadyRowMoveToSquare:
SwapToMap(HirschringSquare,8,12)
CALL LoadHirschringSigils
LoadSquareUnits
LoadVendorSecond
FADU 10
EndEvent

ShadyRowMoveToDuelingGrounds:
SwapToMap(DuelingGrounds,9,17)
CALL LoadDuelingGroundsSigils
//eventual song
MUSC Song_PictionaryTitle
//4th is C5
//call makes my life easier
CALL LoadDuelingGroundsUnits
FADU 10
EndEvent

LoadDuelingGroundsUnits:
LoadUnitsByVisit(DummyUnits,DummyUnits,DummyUnits,DuelingGroundsUnitsC5,DuelingGroundsUnitsC8,0,0,0,0,0,0,0,0,0)
ENDA

ShadyRowMoveToShadesong:
SwapToMap(Shadesong,1,3)
CALL LoadShadesongSigils
//eventual song
MUSC Song_BlueInGreen
//4th is C5
LoadUnitsByVisit(DummyUnits,DummyUnits,DummyUnits,ShadesongUnitsC5,ShadesongUnitsC8,0,0,0,0,0,0,0,0,0)
FADU 10
EndEvent

ShadyRowMoveToImperialPost:
SwapToMap(ImperialPost,1,5)
CALL LoadImperialPostSigils
//4th is C5
LoadUnitsByVisit(DummyUnits,DummyUnits,DummyUnits,ImperialPostUnitsC5,ImperialPostUnitsC8,0,0,0,0,0,0,0,0,0)
FADU 10
EndEvent
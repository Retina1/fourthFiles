//northern pass
AreaEvent(LocationFlagNorthernPass,NorthernPassMoveToSquare,0,19,1,19)
AreaEvent(LocationFlagNorthernPass,NorthernPassMoveToMuseum,2,5)
AreaEvent(LocationFlagNorthernPass,NorthernPassMoveToBlackMarket,16,17)

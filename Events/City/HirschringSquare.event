#define MovementUnsetter "SetUnitStatusAll(0x1*0x100+0xff , MovBonus, 0, AnyDeployed, PlayerArmy,AnyClass,AnyRange,AnyItem)"

#define LoadSquareUnits "LoadUnitsByVisit(Chapter2SquareUnits,Chapter3SquareUnits,Stratum1SquareUnits,Chapter5SquareUnits,Chapter8SquareUnits,0,0,0,0,0,0,0,0,0)"
#define LoadPassUnits "LoadUnitsByVisit(DummyUnits,NorthernPassUnitsC3,NorthernPassUnitsS1,NorthernPassUnitsC5,NorthernPassUnitsC8,0,0,0,0,0,0,0,0,0)"
#define LoadRowUnits "LoadUnitsByVisit(DummyUnits,DummyUnits,DummyUnits,ShadyRowUnitsC5,ShadyRowUnitsC8,0,0,0,0,0,0,0,0,0)"

ALIGN 4

LoadHirschringSigils:
ENUF LocationFlagHirschringSquare
AddSigil(4,3)
AddSigil(14,5)
AddSigil(15,11)
AddRedSigil(6,9)
CHECK_EVENTID Chapter3DoneFlag
BEQ 0x1 0xc 0x0
AddSigil(0,0)
AddSigil(1,0)
LABEL 0x1
CHECK_EVENTID Chapter5DoneFlag
BEQ 0x2 0xc 0x0
AddSigil(7,13)
AddSigil(8,13)
LABEL 0x2
ENDA

IntroTexts:
RunEventByVisit(Chapter2CityOpen,Chapter3CityOpen,Stratum1CityOpen,Chapter5CityOpen,Chapter8CityOpen,0,0,0,0,0,0,0,0,0)
ENDA

DisplayCurrentCityVisit:
SetBackground(0x35)
RunSystemTextByVisit(CityVisit02,CityVisit03,CityVisitS1,CityVisit05,CityVisit08,CityVisit09,CityVisit10,CityVisitS3,CityVisit13,CityVisit15,CityVisit16,CityVisit18A,CityVisit18B,CityVisit18C)
FADI 16
CLEAN
ENDA


BeginningScene:
CALL DisplayCurrentCityVisit
//add thing to display current city visit
DifficultySwapper
ENUF WaitEventTrapsFlag
CHECK_EVENTID Chapter3DoneFlag
BNE 0x2 0xc 0x0
LOAD1 0x0 Chapter2SquareUnitsPreps
LABEL 0x2
ResetMapFlags
InitializeRecruitFlags
ENUF LocationFlagHirschringSquare
CALL IntroTexts
CALL LoadHirschringSigils
CallPreps
CALL LoadPostPrepsUnits
FADU 10
RunTextByVisit(City02_PostPreps,City03_PostPreps,CityS1_PostPreps,City05_PostPreps,City08_PostPreps,0,0,0,0,0,0,0,0,0)
GiveMoneyByVisit(2000,2500,1500,3000,5000,4000,5000,6000,10000,8000,15000,20000,20000,25000)
CHECK_EVENTID Chapter3DoneFlag
BNE 0x1 0xc 0x0
CHECK_TUTORIAL ; BEQ 0x1 0xC 0x0
SystemText(TownTutorial)
LABEL 0x1
EndEvent


EndingScene:
EndingSceneToggles
EndingMapFlags
//MovementUnsetter 
//add route split logic
RunEventByVisit(Chapter2CityEnd,Chapter3CityEnd,Stratum1CityEnd,Chapter5CityEnd,Chapter8CityEnd,0,0,0,0,0,0,0,0,0)
MoveToNextChapter(Chapter3,Stratum1F1,Chapter4,Chapter6,Chapter9,Chapter10,Stratum3F1,Chapter11,Chapter14,Chapter16)
ENDA

LoadPostPrepsUnits:
LoadUnitsByVisit(Chapter2SquareUnitsBlues,Chapter3SquareUnits,Stratum1SquareUnits,Chapter5SquareUnits,Chapter8SquareUnits,0,0,0,0,0,0,0,0,0)
LoadVendorSecond
ENDA

SquareMoveToGuildhall:
SwapToMap(Guildhall,4,14)
CALL LoadGuildhallSigils
LOAD1 0x0 BehindCounterGerson
FADU 10
EndEvent

SquareMoveToBlacksmith:
SwapToMap(Blacksmith,7,8)
CALL LoadBlacksmithSigils
//SetMapBGM(Song_DrawHeroes)
MUSC Song_DrawHeroes
LoadUnitsByVisit(BlacksmithUnitsC2,BlacksmithUnitsC3,BlacksmithUnitsS1,BlacksmithUnitsC5,BlacksmithUnitsC8,0,0,0,0,0,0,0,0,0)
FADU 10
EndEvent

SquareMoveToTavern:
SwapToMap(Tavern,2,8)
CALL LoadTavernSigils
//SetMapBGM(Song_DrawHeroes)
MUSC Song_DrawHeroes
LoadUnitsByVisit(TavernUnitsC2,TavernUnitsC3,TavernUnitsS1,TavernUnitsC5,TavernUnitsC8,0,0,0,0,0,0,0,0,0)
LoadMagusUnlocker
FADU 10
CALL QuestEndChecker
EndEvent

SquareMoveToNorthernPass:
CHECK_EVENTID Chapter3DoneFlag
BEQ 0x1 0xc 0x0
SwapToMap(NorthernPass,1,17)
CALL LoadNorthernPassSigils
LoadPassUnits
FADU 10
GOTO 0x2
LABEL 0x1
ENUF LocationFlagHirschringSquare
LABEL 0x2
EndEvent

SquareMoveToShadyRow:
CHECK_EVENTID Chapter5DoneFlag
BEQ 0x1 0xc 0x0
SwapToMap(ShadyRow,5,1)
CALL LoadShadyRowSigils
LoadRowUnits
FADU 10
GOTO 0x2
LABEL 0x1
ENUF LocationFlagHirschringSquare
LABEL 0x2
EndEvent


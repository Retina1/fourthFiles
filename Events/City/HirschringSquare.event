#define ResetMapFlags "ENUT NoRescuingFlag; ENUT 0x66; ENUT LocationFlagHirschringSquare; ENUT LocationFlagGuildhall; ENUT LocationFlagBlacksmith; ENUT LocationFlagTavern; ENUT LocationFlagNorthernPass; ENUT LocationFlagMuseum; ENUT LocationFlagBlackMarket; ENUT LocationFlagShadyRow; ENUT LocationFlagDuelingGrounds; ENUT LocationFlagShadesong; ENUT LocationFlagImperialPost; ENUT LocationFlagMinisterPark; ENUT LocationFlagRiverHirsch; ENUT LocationFlagEmeraldGrove; ENUT LocationFlagUnderground; ENUT LocationFlagGamerspace; ENUT LocationFlagImperialCourtyard"
#define EndingMapFlags "ENUF NoRescuingFlag; ENUF 0x66; ENUF LocationFlagHirschringSquare; ENUF LocationFlagGuildhall; ENUF LocationFlagBlacksmith; ENUF LocationFlagTavern; ENUF LocationFlagNorthernPass; ENUF LocationFlagMuseum; ENUF LocationFlagBlackMarket; ENUF LocationFlagShadyRow; ENUF LocationFlagDuelingGrounds; ENUF LocationFlagShadesong; ENUF LocationFlagImperialPost; ENUF LocationFlagMinisterPark; ENUF LocationFlagRiverHirsch; ENUF LocationFlagEmeraldGrove; ENUF LocationFlagUnderground; ENUF LocationFlagGamerspace; ENUF LocationFlagImperialCourtyard; ENUF Recruited1Flag; ENUF Recruited2Flag; ENUF Recruited3Flag; ENUF Recruited4Flag; ENUF Recruited5Flag"
#define ClearMap "FADI 10; SET_ACTIVE 0; CLEA 0; CLEN 0; CLEE 0"
#define MoveToMap(mapid) "LOMA mapid"
#define InitializeNathan(x,y) "MOVE 0xFFFF Nathan [x,y]; ENUN; CAM1 Nathan"
#define ResetNathan "SVAL 4 0x03; SetUnitStatus(Nathan,0xc,0x0)"
#define SwapToMap(mapid,x,y) "ResetMapFlags; ClearMap; MoveToMap(mapid); InitializeNathan(x,y)"
#define ThreeRecruitInterlude "ENUT Recruited3Flag; ENUT Recruited2Flag; ENUT Recruited1Flag"
#define FourRecruitInterlude "ENUT Recruited4Flag; ThreeRecruitInterlude"
#define FiveRecruitInterlude "ENUT Recruited5Flag; FourRecruitInterlude"

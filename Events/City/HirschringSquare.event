//marketplace

//in museum
AreaEvent(LocationFlagMuseum,MuseumMoveToNorthernPass,4,17,7,17)
AreaEvent(LocationFlagMuseum,MuseumEventBegin,5,10)

//in black market
AreaEvent(LocationFlagBlackMarket,BlackMarketMoveToNorthernPass,0,1,0,2)
AreaEvent(LocationFlagBlackMarket,BlackMarketLoopBegin,9,3)

//in shady row
AreaEvent(LocationFlagShadyRow,ShadyRowMoveToSquare,4,0,6,0)
AreaEvent(LocationFlagShadyRow,ShadyRowMoveToDuelingGrounds,13,1)
AreaEvent(LocationFlagShadyRow,ShadyRowMoveToShadesong,20,10)
AreaEvent(LocationFlagShadyRow,ShadyRowMoveToImperialPost,25,0,25,2)

//in dueling grounds
AreaEvent(LocationFlagDuelingGrounds,DuelingGroundsMoveToShadyRow,7,18,11,18)
AreaEvent(LocationFlagDuelingGrounds,DuelingGroundsBegin,9,15)
AFEV LocationFlagDuelingGrounds DuelingGroundsAdvanceWrapper 0x6
AFEV LocationFlagDuelingGrounds DuelingGroundsDeathChecker 0x0

//in shadesong
AreaEvent(LocationFlagShadesong,ShadesongMoveToShadyRow,0,3,0,4)

//in imperial post
AreaEvent(LocationFlagImperialPost,ImperialPostMoveToShadyRow,0,4,0,5)
AreaEvent(LocationFlagImperialPost,TownFourthTalk,3,5)

CauseGameOverIfLordDies
END_MAIN

Dunno:
END_MAIN

Tutorial:
END_MAIN

TrapData:
ENDTRAP


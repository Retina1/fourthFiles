LoadBlacksmithSigils:
ENUF LocationFlagBlacksmith
AddSigil(6,9)
AddSigil(7,9)
AddSigil(8,9)
AddGreenSigil(7,3)
ENDA

BlacksmithMoveToSquare:
SwapToMap(HirschringSquare,14,6)
CALL LoadHirschringSigils
//causes visual bug? not needed anyway
//SetMapBGM(Song_VastLands)
MUSC Song_VastLands
LoadSquareUnits
LoadVendorSecond
FADU 10
EndEvent

//make stratum 1
BlacksmithShopBegin:
CHECK_EVENTID 0x1e
BNE 0x1 0xc 0x0
RunTextByVisit(City02_BenjaminIntro,City03_Benjamin,CityS1_Benjamin,City05_Benjamin,City08_Benjamin,0,0,0,0,0,0,0,0,0)
//conditionals
CHECK_EVENTID BeastKingConditionalFlag
BEQ 0x2 0xc 0x0
	Text(City_BenjaminCh4BossConditional)
	GiveItem(KingBrooch,Nathan)
	ENUF BeastKingConditionalFlag
LABEL 0x2
CHECK_EVENTID BenthusConditionalFlag
BEQ 0x3 0xc 0x0
	Text(City_BenjaminCh8BossConditional)
	GiveItem(ThornCrown,Nathan)
	ENUF BenthusConditionalFlag
LABEL 0x3

ENUT 0x1e
LABEL 0x1
//johanna runs it for c3x, c8x, s3x, 18Cx
LoadShopByVisit(Ch2Shop,Ch3Shop,S1Shop,Ch5Shop,Ch8Shop,0,0,0,0,0,0,0,0,0)
ENUF LocationFlagBlacksmith
EndEvent

BlacksmithTestShopBegin:
MakeShop(TestShop)
ENUF LocationFlagBlacksmith
EndEvent
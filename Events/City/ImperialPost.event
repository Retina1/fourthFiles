//MESSAGE Events end at offset CURRENTOFFSET

ALIGN 4

ShadyRowMoveToImperialPost:
SwapToMap(ImperialPost,1,5)
CALL LoadImperialPostSigils
//4th is C5
LoadUnitsByVisit(DummyUnits,DummyUnits,DummyUnits,ImperialPostUnitsC5,ImperialPostUnitsC8,ImperialPostUnitsC9,0,0,0,0,0,0,0,0)
FADU 10
EndEvent

ALIGN 4
LoadImperialPostSigils:
ENUF LocationFlagImperialPost
AddSigil(0,4)
AddSigil(0,5)
AddGreenSigil(3,5)
//AddGreenSigil(10,11)
ENDA

ImperialPostMoveToShadyRow:
SwapToMap(ShadyRow,24,1)
CALL LoadShadyRowSigils
LoadRowUnits
FADU 10
EndEvent

ALIGN 4

BeginningScene:
DifficultySwapper
CleanTextNoMap(0x3,Dungeon1_Opening)
CallPreps
CLEA 0
//set all deployed units to be undeployed but with the not deployed last chapter thing unset
//that'll clean it up
InitializeNathan(12,18)
//initialize flag so we don't have a first screen flash
ENUT WaitEventTrapsFlag
CHECK_EVENTID Quest2_3x_Flag
BNE 0x1 0xc 0x0
ENUT 0xd
LABEL 0x1
FADU 16
CHECK_TUTORIAL ; BEQ 9999 0xC 0x0
SystemText(DungeonTutorial)
LABEL 9999
ENUT 0x66
EndEvent

Encounter1:
BeginCombatEncounter
LOAD3 0x0 Encounter1Units; ENUN
LoadUnitsByDifficulty(Encounter1Enemies,Encounter1EnemiesExpert,Encounter1EnemiesHeroic)
CreateArenaBorders(13,8,21,15)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Encounter2:
BeginCombatEncounter
LOAD3 0x0 Encounter2Units; ENUN
LoadUnitsByDifficulty(Encounter2Enemies,Encounter2EnemiesExpert,Encounter2EnemiesHeroic)
CreateArenaSingleCorner(14,8)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Encounter3:
BeginCombatEncounter
LOAD3 0x0 Encounter3Units; ENUN
LoadUnitsByDifficulty(Encounter3Enemies,Encounter3EnemiesExpert,Encounter3EnemiesHeroic)
CreateArenaBorders(6,6,14,12)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Encounter4:
BeginCombatEncounter
LOAD3 0x0 Encounter4Units; ENUN
LoadUnitsByDifficulty(Encounter4Enemies,Encounter4EnemiesExpert,Encounter4EnemiesHeroic)
CreateArenaSingleCorner(5,4)
CreateArenaSingleCorner(5,15)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Quest2_3x_Event:
SystemText(Quest2_3x_System)
ENUT Quest2_3x_DoneFlag
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC Song_EverScarletForest
SetMapBGM(Song_EverScarletForest)
EndEvent

EndingScene:
EVBIT_MODIFY 3
SystemText(NextFloorOneWay)
IfNoSelectedGoto(0x1)
MNC3 Stratum1F2
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(1,2); FADU 16
LABEL 0x2
EndEvent


//MESSAGE Events end at offset CURRENTOFFSET
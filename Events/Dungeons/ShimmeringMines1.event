ALIGN 4

BeginningScene:
DifficultySwapper
MUSC AmbientShimmer
//scene of gore no eye, resolve to survive
CleanTextNoMap(CaveCG,FillerDialogue)


CallPreps
CLEA 0
//set all deployed units to be undeployed but with the not deployed last chapter thing unset
//that'll clean it up
InitializeNathan(1,2)
//initialize flag so we don't have a first screen flash
ENUT WaitEventTrapsFlag
ENUT 0x66
EndEvent

Encounter1:
CHECK_EVENTID WaitEventTrapsFlag
BEQ 0x1 0xc 0x0
BeginCombatEncounter
LOAD3 0x0 Encounter1Units; ENUN
LOAD1 0x0 Encounter1Enemies; ENUN
CreateArenaBorders(3,2,11,8)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
GOTO 0x2
LABEL 0x1
ENUF 0x9
LABEL 0x2
EndEvent

Encounter2:
CHECK_EVENTID WaitEventTrapsFlag
BEQ 0x1 0xc 0x0
BeginCombatEncounter
LOAD3 0x0 Encounter2Units; ENUN
LOAD1 0x0 Encounter2Enemies; ENUN
CreateArenaSingleCorner(14,16)
CreateArenaSingleCorner(25,16)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
GOTO 0x2
LABEL 0x1
ENUF 0xa
LABEL 0x2
EndEvent

Encounter3:
CHECK_EVENTID WaitEventTrapsFlag
BEQ 0x1 0xc 0x0
BeginCombatEncounter
LOAD3 0x0 Encounter3Units; ENUN
LOAD1 0x0 Encounter3Enemies; ENUN
CreateArenaSingleCorner(21,19)
CreateArenaSingleCorner(29,19)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
GOTO 0x2
LABEL 0x1
ENUF 0xb
LABEL 0x2
EndEvent

EncounterFOE:
EVBIT_MODIFY 3
SystemText(FOEWarning)
IfNoSelectedGoto(0x1)
BeginCombatEncounter
LOAD3 0x0 EncounterFOEUnits; ENUN
LOAD1 0x0 EncounterFOEEnemies; ENUN
CreateArenaSingleCorner(22,4)
FADU 16
MUSC Song_IsThatBloodThine
SetMapBGM(Song_IsThatBloodThine)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(27,9); FADU 16
ENUF 0xd
LABEL 0x2
EndEvent

EncounterRatatoskr:
EVBIT_MODIFY 3
SystemText(SuperbossWarning)
IfNoSelectedGoto(0x1)
SystemText(Ratatoskr_Encounter2)
BeginCombatEncounter
LOAD3 0x0 EncounterRatatoskrUnits; ENUN
LOAD1 0x0 EncounterRatatoskrEnemies; ENUN
SetUnitStatline(Ratatoskr,35,12,21,25,33,23,4,3)
CreateArenaSingleCorner(11,6)
CreateArenaSingleCorner(11,0)
FADU 16
MUSC Song_EndOfRagingWaves
SetMapBGM(Song_EndOfRagingWaves)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(1,2); FADU 16
ENUF 0xe
LABEL 0x2
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC Song_CursedCathedral
SetMapBGM(Song_CursedCathedral)
EndEvent

EndingScene:
SystemText(NextFloorOneWay)
IfNoSelectedGoto(0x1)
MNC3 Stratum2F2
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(28,22); FADU 16
LABEL 0x2
EndEvent


ALIGN 4

BeginningScene:
CallPreps
CLEA 0
//set all deployed units to be undeployed but with the not deployed last chapter thing unset
//that'll clean it up
InitializeNathan(1,2)
//initialize flag so we don't have a first screen flash
ENUT WaitEventTrapsFlag
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC 0
SetMapBGM(0)
EndEvent

EndingScene:
SystemText(NextFloorOneWay)
IfNoSelectedGoto(0x1)
MNC3 Stratum2F2
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(28,22); FADU 16
LABEL 0x2
EndEvent


#include EAstdlib.event

EventPointerTable(Stratum6F8EventsID,ThisChapter)


ALIGN 4

ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN Dunno Dunno Dunno
POIN Tutorial
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene

TurnBasedEvents:
END_MAIN
ALIGN 32 //For some reason, CharacterBasedEvents have to be 32-Aligned?

CharacterBasedEvents:
END_MAIN

LocationBasedEvents:
END_MAIN

MiscBasedEvents:
AFEV 0x0 MoveResetter 0x6
AreaEvent(0x0,EndingScene,16,0,18,1)
AreaEvent(0x9,Encounter1,12,25)
//AreaEvent(0xa,Encounter2,19,5)
//AreaEvent(0xd,EncounterFOE,15,0)
AreaEvent(0x0,Warp0_10,0,10)
AreaEvent(0x0,Warp0_11,0,11)

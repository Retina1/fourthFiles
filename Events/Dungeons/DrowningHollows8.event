ALIGN 4



EndingScene:
SystemText(CompleteDungeonSys)
IfNoSelectedGoto(0x1)
EndingSceneToggles
ENUF WaitEventTrapsFlag
ENUF 0x66
MoveToChapter(EndgameC)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(17,3); FADU 16
LABEL 0x2
EndEvent

BeginningScene:
InitializeNathan(17,28)
ENUT WaitEventTrapsFlag
EndEvent

Encounter1:
CHECK_EVENTID WaitEventTrapsFlag
BEQ 0x1 0xc 0x0
BeginCombatEncounter
LOAD3 0x0 Encounter1Units; ENUN
LoadUnitsByDifficulty(Encounter1Enemies,Encounter1Enemies,Encounter1Enemies)
CreateArenaBorders(8,21,13,26)
FADU 16
//MUSC Song_SinSpreadsInOurHearts
//SetMapBGM(Song_SinSpreadsInOurHearts)
GOTO 0x2
LABEL 0x1
ENUF 0x9
LABEL 0x2
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
//MUSC Song_SinSpreadsInOurHearts
//SetMapBGM(Song_SinSpreadsInOurHearts)
EndEvent



ALIGN 4

BeginningScene:
InitializeNathan(1,1)
ENUT WaitEventTrapsFlag
EndEvent

Encounter1:
BeginCombatEncounter
LOAD3 0x0 Encounter1Units; ENUN
LOAD1 0x0 Encounter1Enemies; ENUN
CreateArenaBorders(4,1,14,11)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Encounter2:
BeginCombatEncounter
LOAD3 0x0 Encounter2Units; ENUN
LOAD1 0x0 Encounter2Enemies; ENUN
CreateArenaSingleCorner(8,12)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Encounter3:
BeginCombatEncounter
LOAD3 0x0 Encounter3Units; ENUN
LOAD1 0x0 Encounter3Enemies; ENUN
CreateArenaSingleCorner(15,11)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent


EncounterFOE:
EVBIT_MODIFY 3
SystemText(FOEWarning)
IfNoSelectedGoto(0x1)
BeginCombatEncounter
LOAD3 0x0 EncounterFOEUnits; ENUN
LOAD1 0x0 EncounterFOEEnemies; ENUN
CreateArenaSingleCorner(15,8)
FADU 16
MUSC Song_IsThatBloodThine
SetMapBGM(Song_IsThatBloodThine)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(19,8); FADU 16
ENUF 0xd
LABEL 0x2
EndEvent

EncounterRatatoskr:
EVBIT_MODIFY 3
SystemText(SuperbossWarning)
IfNoSelectedGoto(0x1)
SystemText(Ratatoskr_Encounter1)
BeginCombatEncounter
LOAD3 0x0 EncounterRatatoskrUnits; ENUN
LOAD1 0x0 EncounterRatatoskrEnemies; ENUN
SetUnitStatline(Ratatoskr,25,7,16,21,28,18,3,2)
CreateArenaBorders(5,4,16,14)
FADU 16
MUSC Song_EndOfRagingWaves
SetMapBGM(Song_EndOfRagingWaves)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(17,13); FADU 16
ENUF 0xe
LABEL 0x2
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC Song_EverScarletForest
SetMapBGM(Song_EverScarletForest)
EndEvent

EndingScene:
EVBIT_MODIFY 3
SystemText(NextFloorOneWay)
IfNoSelectedGoto(0x1)
MNC3 Stratum1F3
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(22,9); FADU 16
LABEL 0x2
EndEvent


//MESSAGE Events end at offset CURRENTOFFSET
BeginningScene:
InitializeNathan(28,22)
ENUT WaitEventTrapsFlag
CHECK_EVENTID Quest1_5x_Flag
BNE 0x1 0xc 0x0
ENUT 0xd
LABEL 0x1
ENUT 0xf
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC 0
SetMapBGM(Song_CursedCathedral)
EndEvent

Quest1_5x_Event:
SystemText(Quest1_5x_System)
ENUT Quest1_5x_DoneFlag
ENUF 0xf
EndEvent

EncounterWyvern:
EVBIT_MODIFY 3
SystemText(SuperbossWarning)
IfNoSelectedGoto(0x1)
SystemText(Wyvern_Encounter)
BeginCombatEncounter
LOAD3 0x0 EncounterWyvernUnits; ENUN
LOAD1 0x0 EncounterWyvernEnemies; ENUN
SetUnitStatline(Dragon,55,16,12,18,16,10,15,16)
CreateArenaSingleCorner(9,12)
FADU 16
MUSC Song_EndOfRagingWaves
SetMapBGM(Song_EndOfRagingWaves)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(12,16); FADU 16
ENUF 0xf
LABEL 0x2
EndEvent

EndingScene:
SystemText(NextFloorOneWay)
IfNoSelectedGoto(0x1)
MNC3 Stratum2F3
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(1,4); FADU 16
LABEL 0x2
EndEvent



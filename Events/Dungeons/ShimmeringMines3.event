ALIGN 4

FloorReset:
EVBIT_MODIFY 3
SystemText(FloorResetWarning)
IfNoSelectedGoto(0x1)
FADI 16; InitializeNathan(1,4); FADU 16
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(14,15); FADU 16
LABEL 0x2
EndEvent


EndingScene:
SystemText(CompleteDungeonSys)
IfNoSelectedGoto(0x1)
EndingSceneToggles
ENUF WaitEventTrapsFlag
ENUF 0x66
MUSC AmbientShimmer
//triumph and reclamation march
CleanTextNoMap(CaveCG,Dungeon2_Ending1)
//guild scene with benthus
LOMA Chapter8
CLEA 0
CAM1 [9,0]
LOAD2 0x1 EndingCutscene;ENUN
WEATHER 0
FADU 10
MUSC Song_DevilsRoulette
MOVE 5 Benthus [9,4]; ENUN; STAL 30
Text(Dungeon2_Ending2)
STAL 40
MOVE 3 BossGuildmaster [9,0]; ENUN; SilentKillUnit(BossGuildmaster); STAL 30
Text(Dungeon2_Ending3)
STAL 60
FADI 5
STAL 60
MOVE 0xffff Benthus [9,2]; ENUN; 
RECLASS Benthus Sovereign
FADU 5
STAL 60
FADI 5
STAL 60
LOAD2 0x1 EndingCutscene2; ENUN
FADU 5
STAL 60
FADI 5
STAL 60
WEATHER 4
LOAD2 0x1 EndingCutscene3; ENUN
FADU 5
STAL 60
FADI 5
MoveToChapter(Chapter8)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(15,13); FADU 16
LABEL 0x2
EndEvent

BeginningScene:
InitializeNathan(1,4)
ENUT WaitEventTrapsFlag
EndEvent

Encounter1:
CHECK_EVENTID WaitEventTrapsFlag
BEQ 0x1 0xc 0x0
BeginCombatEncounter
LOAD3 0x0 Encounter1Units; ENUN
LoadUnitsByDifficulty(Encounter1Enemies,Encounter1EnemiesExpert,Encounter1EnemiesHeroic)
CreateArenaSingleCorner(23,7)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
GOTO 0x2
LABEL 0x1
ENUF 0x9
LABEL 0x2
EndEvent

Encounter2:
CHECK_EVENTID WaitEventTrapsFlag
BEQ 0x1 0xc 0x0
BeginCombatEncounter
LOAD3 0x0 Encounter2Units; ENUN
LoadUnitsByDifficulty(Encounter2Enemies,Encounter2EnemiesExpert,Encounter2EnemiesHeroic)
CreateArenaSingleCorner(17,9)
CreateArenaSingleCorner(26,0)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
GOTO 0x2
LABEL 0x1
ENUF 0xa
LABEL 0x2
EndEvent

EncounterFOE:
EVBIT_MODIFY 3
SystemText(FOEWarning)
IfNoSelectedGoto(0x1)
BeginCombatEncounter
LOAD3 0x0 EncounterFOEUnits; ENUN
LoadUnitsByDifficulty(EncounterFOEEnemies,EncounterFOEEnemiesExpert,EncounterFOEEnemiesHeroic)
CreateArenaSingleCorner(11,3)
FADU 16
MUSC Song_IsThatBloodThine
SetMapBGM(Song_IsThatBloodThine)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(14,0); FADU 16
ENUF 0xd
LABEL 0x2
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC Song_CursedCathedral
SetMapBGM(Song_CursedCathedral)
EndEvent



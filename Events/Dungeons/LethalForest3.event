ALIGN 4

BeginningScene:
InitializeNathan(24,9)
ENUT WaitEventTrapsFlag
EndEvent

Encounter1:
BeginCombatEncounter
LOAD3 0x0 Encounter1Units; ENUN
LoadUnitsByDifficulty(Encounter1Enemies,Encounter1EnemiesExpert,Encounter1EnemiesHeroic)
CreateArenaSingleCorner(16,7)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Encounter2:
BeginCombatEncounter
LOAD3 0x0 Encounter2Units; ENUN
LoadUnitsByDifficulty(Encounter2Enemies,Encounter2EnemiesExpert,Encounter2EnemiesHeroic)
CreateArenaSingleCorner(15,4)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent

Encounter3:
BeginCombatEncounter
LOAD3 0x0 Encounter3Units; ENUN
LoadUnitsByDifficulty(Encounter3Enemies,Encounter3EnemiesExpert,Encounter3EnemiesHeroic)
CreateArenaSingleCorner(9,8)
FADU 16
MUSC Song_InitialStrike
SetMapBGM(Song_InitialStrike)
EndEvent


EncounterFOE:
EVBIT_MODIFY 3
SystemText(FOEWarning)
IfNoSelectedGoto(0x1)
BeginCombatEncounter
LOAD3 0x0 EncounterFOEUnits; ENUN
LoadUnitsByDifficulty(EncounterFOEEnemies,EncounterFOEEnemiesExpert,EncounterFOEEnemiesHeroic)
CreateArenaSingleCorner(10,6)
FADU 16
MUSC Song_IsThatBloodThine
SetMapBGM(Song_IsThatBloodThine)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(5,1); FADU 16
ENUF 0xd
LABEL 0x2
EndEvent

UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC Song_EverScarletForest
SetMapBGM(Song_EverScarletForest)
EndEvent

EndingScene:
EVBIT_MODIFY 3
SystemText(CompleteDungeonSys)
IfNoSelectedGoto(0x1)
EndingSceneToggles
ENUT Stratum1DoneFlag
ENUF WaitEventTrapsFlag
ENUF 0x66
MUSC Song_EditMode
CleanTextNoMap(0x1f,Dungeon1_Ending)
MoveToChapter(HirschringSquare)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(12,9); FADU 16
LABEL 0x2
EndEvent


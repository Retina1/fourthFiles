ALIGN 4

BeginningScene:
CHECK_EVENTID WastesFloorSwapFlagTrue
BNE 0x1 0xc 0x0
DifficultySwapper
MUSC AmbientWindBirds
ResetWastesFloorSwapFlags
ResetWastesProgressFlags
CleanTextNoMap(0x1f,FillerDialogue)
CallPreps
CLEA 0
InitializeNathan(11,22)
ENUT WaitEventTrapsFlag
ENUT WastesFloorSwapFlagTrue
ENUT 0x66
GOTO 0x2
LABEL 0x1
ENUT WaitEventTrapsFlag
WastesChest(WastesChestFlag1,0)
WastesChest(WastesChestFlag2,1)
InitializeNathanByFlag(WastesFloorSwapFlag1,18,22)
InitializeNathanByFlag(WastesFloorSwapFlag2,7,20)
InitializeNathanByFlag(WastesFloorSwapFlag3,5,17)
InitializeNathanByFlag(WastesFloorSwapFlag4,1,13)
InitializeNathanByFlag(WastesFloorSwapFlag5,8,12)
InitializeNathanByFlag(WastesFloorSwapFlag6,11,12)
InitializeNathanByFlag(WastesFloorSwapFlag7,6,11)
InitializeNathanByFlag(WastesFloorSwapFlag8,0,10)
InitializeNathanByFlag(WastesFloorSwapFlag9,15,10)
InitializeNathanByFlag(WastesFloorSwapFlag10,17,9)
InitializeNathanByFlag(WastesFloorSwapFlag11,7,7)
InitializeNathanByFlag(WastesFloorSwapFlag12,11,7)
InitializeNathanByFlag(WastesFloorSwapFlag13,0,6)
InitializeNathanByFlag(WastesFloorSwapFlag14,4,6)
InitializeNathanByFlag(WastesFloorSwapFlag15,9,5)
InitializeNathanByFlag(WastesFloorSwapFlag16,12,5)
InitializeNathanByFlag(WastesFloorSwapFlag17,7,3)
InitializeNathanByFlag(WastesFloorSwapFlag18,4,2)
LABEL 0x2
EndEvent

Encounter1:
BeginCombatEncounter
LOAD3 0x0 Encounter1Units; ENUN
LoadUnitsByDifficulty(Encounter1Enemies,Encounter1Enemies,Encounter1Enemies)
CreateArenaSingleCorner(7,15)
FADU 16
MUSC Song_InspectingTheResoundingWeapons
SetMapBGM(Song_InspectingTheResoundingWeapons)
EndEvent

Encounter2:
BeginCombatEncounter
LOAD3 0x0 Encounter2Units; ENUN
LoadUnitsByDifficulty(Encounter2Enemies,Encounter2Enemies,Encounter2Enemies)
CreateArenaSingleCorner(8,4)
FADU 16
MUSC Song_InspectingTheResoundingWeapons
SetMapBGM(Song_InspectingTheResoundingWeapons)
EndEvent

EncounterFOE:
EVBIT_MODIFY 3
SystemText(FOEWarning)
IfNoSelectedGoto(0x1)
BeginCombatEncounter
LOAD3 0x0 EncounterFOEUnits; ENUN
LoadUnitsByDifficulty(EncounterFOEEnemies,EncounterFOEEnemies,EncounterFOEEnemies)
CreateArenaBorders(3,1,11,9)
FADU 16
MUSC Song_IsThatBloodThine
SetMapBGM(Song_IsThatBloodThine)
GOTO 0x2
LABEL 0x1
FADI 16; InitializeNathan(8,5); FADU 16
ENUF WastesEncounterFlag3
LABEL 0x2
EndEvent


UnitCleanup:
FADI 16
ClearArenaBorders
CLEA 0
ResetNathan
FADU 16
MUSC Song_SandyBarrens
SetMapBGM(Song_SandyBarrens)
EndEvent


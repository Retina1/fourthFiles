ALIGN 4

//in scene, GM is present then leaves to help people/take care of business
BeginningScene:
DifficultySwapper
LOMA Guildhall
LOAD1 0x1 OpeningParty; ENUN
CAM1 [0,0]
FADU 10
STAL 20
MUSC Song_OohWilfre
STAL 30
CleanTextNoMap(0x0,Chapter4_Opening_1)
STAL 10
MUSC 0
CLEA 0; CLEN 0
LOMA Chapter5
LOAD1 0x1 OpeningParty2; ENUN
CAM1 [9,0]
FADU 10
STAL 20
Text(Chapter5_Opening_2)
//guildmaster cursor
FlashCursor(BossGuildmaster,30)
Text(Chapter5_Opening_3)
//walk up
STAL 20
MOVE 5 Nathan [10,2]; ENUN; STAL 20
Text(Chapter5_Opening_4)
//walk back
STAL 20
MOVE 5 Nathan [6,6]; ENUN; STAL 20
Text(Chapter5_Opening_5)
//terrorism
WARPIN [10,1]
LOAD1 0x1 OpeningXavens; ENUN
ENDWARP
STAL 20
MUSC Song_PandemonicPlanet
STAL 20
LOAD1 0x1 OpeningEndbringer; ENUN
STAL 40
MOVE 120 Kryst [18,13]; ENUN;
Text(Chapter5_Opening_6)
//guildmaster out
MOVE 10 Gerson [5,0]; MOVE 10 BossGuildmaster [6,1]; ENUN
Text(Chapter5_Opening_7)
MOVE 10 Gerson [0,0]; MOVE 10 BossGuildmaster [0,0]; ENUN
FADI 10
CLEA 0; CLEN 0; CLEE 0
LOAD1 0x1 EnemyUnits; ENUN
LOAD1 0x1 KrystJoin; ENUN
//starting skills
//kryst - level 1 soothing voice/bravery/shelter/mercury/insight
LevelUpSkill(Kryst,0)
LevelUpSkill(Kryst,7)
LevelUpSkill(Kryst,8)
LevelUpSkill(Kryst,9)
LevelUpSkill(Kryst,10)
CallPreps
TurnAlly(Kryst)
MUSC Song_FaithIsMyPillar
Text(Chapter5_KrystJoin) //nathan comments on wolf, gets paper thrown at him
EndEvent

EndbringerLeaves:
CAM1 [15,0]
FlashCursor(Xavens,30)
Text(Chapter5_XavensLeaves)
STAL 10
CAM1 Xavens
WARPOUT [9,1]
SilentKillUnit(Xavens)
ENDWARP
CAM1 Egil
Text(Chapter5_EgilLeaves)
WARPOUT [10,1]
SilentKillUnit(Egil)
ENDWARP
CAM1 Harla
Text(Chapter5_HarlaLeaves)
WARPOUT [18,1]
SilentKillUnit(Harla)
ENDWARP
EndEvent

EndingScene:
ENUT Chapter5DoneFlag
MUSC 0x0
CleanTextNoMap(0x18,Chapter5_Ending_1)
//endbringer map event
MUSC Song_CherryTreesAndWings
Text(Chapter5_Ending_2)
//in guildhall map
Text(Chapter5_Ending_3)
//cleone walks in
Text(Chapter5_Ending_4)
MoveToChapter(HirschringSquare)
ENDA



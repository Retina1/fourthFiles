BeginningScene:
DifficultySwapper
MUSC Song_OohWilfre
CleanTextNoMap(0x3,C9Opening1)
MUSC 0
LoadUnitsByDifficulty(EnemyUnits,EnemyUnitsExpert,EnemyUnitsHeroic)
SetUnitStatline(MonsterBoss,60,25,2,10,9,1,18,8)
SetUnitWEXP(MonsterBoss,0,0,181,0,0)
LOAD1 0x0 GreenUnits
CAM1 [19,19]
CLEAN
FADU 10
LOAD2 0x1 CutsceneUnits
ENUN
MUSC Song_PandemonicPlanet
Text(C9Opening2)
CallPreps

//disable area event if not doing quest
CHECK_EVENTID Quest1_8x_Flag
BNE 0x2 0xc 0x0
ENUT 0x9
LABEL 0x2
FADU 10
CAM1 George
FlashCursor(George,30)
MUSC Song_DarkBattle
Text(C9OpeningGeorgeIseau)
STAL 15
MOVE 5 George [17,0]
ENUN
SilentKillUnit(George)
CAM1 [6,19]
FlashCursor(6,18,30)
FlashCursor(5,19,30)
FlashCursor(6,19,30)
FlashCursor(7,19,30)
Text(C9OpeningGuild)
SystemText(C9ProtectObjective)
EndEvent

IseauLeaves:
CHECK_ALIVE Iseau
BEQ 0x1 0xc 0x0
CAM1 Iseau
FlashCursor(Iseau,30)
Text(C9IseauLeaves)
STAL 30
MOVE 10 Iseau [18,0]
ENUN
SilentKillUnit(Iseau)
LABEL 0x1
EndEvent


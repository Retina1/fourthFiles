ALIGN 4

BeginningScene:
DifficultySwapper
LOMA Guildhall
LOAD2 0x1 OpeningParty; ENUN
CAM1 [14,8]
FADU 10
STAL 20
MUSC Song_OohWilfre
STAL 30
CleanTextNoMap(0x0,Chapter3_Opening_1)
STAL 10
MUSC 0
CLEA 0; CLEN 0
LOMA Chapter3
LoadUnitsByDifficulty(EnemyUnits,EnemyUnitsExpert,EnemyUnitsHeroic)
LOAD1 0x1 AllyUnits; ENUN
SetUnitStatline(MonsterBoss,27,12,4,13,15,1,6,5)
SetUnitWEXP(MonsterBoss,0,0,0,0,0)
ENUN
CAM1 MonsterBoss
FADU 10
MUSC Song_PandemonicPlanet //crisis music
CAM1 Lucien
FlashCursor(Lucien,30)
FlashCursor(Helman,30)
//lucien helman intro
Text(Chapter3_Opening_2)
CAM1 [5,11]
//load after giving monsters time to exist
LOAD2 0x1 CutsceneUnits
ENUN
SilentKillUnit(Egil)
//preps leadin
Text(Chapter3_Opening_3)
CallPreps
//starting skills
//helman - level 1 leering wall
LevelUpSkill(Helman,0)
EndEvent


Chapter3_House:
VillageEventItem(Chapter3_HouseText, 0x0, ThornWhip)


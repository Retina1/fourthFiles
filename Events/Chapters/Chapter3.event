Chapter3_HelmanAuto:
CHECK_ALLEGIANCE 0xFFFF
BNE 0x1 0xC 0x0
//is player
MUSC Song_FaithIsMyPillar //recruitment theme
Text(Chapter3_HelmanAutoRecruit)
TurnAlly(Helman)
GOTO 0x2
LABEL 0x1
//not player
ENUF 0x8
LABEL 0x2
EndEvent

Chapter3_NathanLucien:
MUSC Song_OohWilfre
Text(Chapter3_NathanLucienTalk)
EndEvent

EndingScene:
ENUT Chapter3DoneFlag
MUSC Song_EditMode
CleanTextNoMap(0x18,Chapter3_Ending_1)
MUSC Song_Salem
CleanTextNoMap(0x0,Chapter3_Ending_2)
MoveToChapter(HirschringSquare)
ENDA

